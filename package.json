{
  "name": "examenator",
  "displayName": "Examenator",
  "description": "Расширение для управления заданиями и тестами",
  "repository": "https://github.com/AltmanEA/examenator",
  "version": "0.0.9",
  "publisher": "AltmanEA",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "examView.runTest",
        "title": "Запустить тест"
      },
      {
        "command": "examView.openTaskAndTest",
        "title": "Открыть задачу и тест"
      },
      {
        "command": "examView.selectBlock",
        "title": "Выбрать блок задач"
      }
    ],
    "menus": {
      "view/title": [],
      "view/item/context": [
        {
          "command": "examView.runTest",
          "when": "view == testsView && viewItem == test",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "exam-container",
          "title": "Экзаменатор",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "exam-container": [
        {
          "id": "tasksView",
          "name": "Задачи",
          "icon": "./media/tasks.svg"
        },
        {
          "id": "testsView",
          "name": "Тесты",
          "icon": "./media/tests.svg"
        },
        {
          "id": "selectedTasksView",
          "name": "Выбранные задачи",
          "icon": "./media/selected-tasks.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run compile-tests && npm run bundle",
    "compile-tests": "tsc -p ./",
    "bundle": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "node esbuild.config.mjs --production",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "sinon": "^21.0.0",
    "typescript": "^5.9.3"
  }
}
